# =============================================================
# omnios-core — environment template
# =============================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is excluded by .gitignore. Never commit real values.
# Keep your personal logins and recovery codes in Apple Passwords,
# not in this file. This file holds SERVICE credentials only.
# =============================================================


# --- Supabase: project connection -----------------------------
# Found in Supabase dashboard → Project Settings → API.

# The project REST/Auth URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. Safe to expose to a browser BECAUSE
# row-level security restricts what it can read or write.
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Service-role key. FULL database access; it BYPASSES row-level
# security. Server-side and local-agent use only.
# Never put this in a browser, a Next.js client component,
# a NEXT_PUBLIC_* variable, a log line, or a Git commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, used only by migration
# scripts. Includes the database password.
# postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_URL=


# --- Dashboard (Next.js) --------------------------------------
# NEXT_PUBLIC_* variables are compiled into the browser bundle.
# Only ever put non-secret values here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key


# --- Local agent ----------------------------------------------
# Human-readable name this machine registers under.
OMNIOS_AGENT_NAME=mac-local-runner

# Runtime class: local | cloud | future_vps
OMNIOS_AGENT_RUNTIME=local

# Root folder the agent is allowed to read and write.
# Any file operation outside this path is refused by policy.
OMNIOS_WORKSPACE_ROOT=/Users/you/omnios-workspace

# Set to "true" to make every run simulate work without writing
# to the database. Useful for a first safe test.
OMNIOS_DRY_RUN=false


# --- Future integrations (adapters exist, disabled by default) -
# Leave blank. Filling these in does NOT enable live actions;
# each adapter also requires an explicit approval record.
GOOGLE_DRIVE_CREDENTIALS=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
GOOGLE_CALENDAR_CREDENTIALS=
FINANCE_API_KEY=
